---
import Layout from '../layouts/Layout.astro';
import { brand } from '../data/brand.js';
import { company } from '../data/company.js';

const title = 'Battery OEM/ODM Manufacturing - Custom Design to Packaging | TIANQIU China Factory';
const description = 'Battery OEM & ODM factory: custom voltage, capacity, size, connector, label & packaging. From spec to mass production. UL/UN38.3 certified. Licensed OEM for global brands.';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Battery OEM / ODM Manufacturing', url: '/oem-battery-manufacturing/' }];

const faqs = [
  { q: 'What is your MOQ for OEM batteries?',
    a: 'MOQ depends on the product. Button and cylindrical cells typically start from 5,000 to 10,000 pcs; custom battery packs are quoted per project after design and sampling.' },
  { q: 'Can you custom print my brand label?',
    a: 'Yes. We print your logo and brand on the cell and on retail-ready packaging — blister, card and box — to your artwork. Licensed-OEM programs are also available.' },
  { q: 'What certifications do you have?',
    a: 'ISO 9001, ISO 45001, BSCI, UL, UN38.3, CE, RoHS, SGS and PONY, plus maritime and air transport certification for safe worldwide shipping.' },
  { q: 'How long is the OEM sample cycle?',
    a: 'Samples are typically produced within 1-2 weeks after we confirm the spec sheet. Custom cells or packs may take a little longer — we confirm the timeline in the quote.' },
  { q: 'What is your lead time for mass production?',
    a: 'Mass-production lead time depends on the line, quantity and packaging. Once the sample is approved we schedule production and confirm a firm delivery date.' },
  { q: 'Can you make custom voltage / capacity batteries?',
    a: 'Yes. We customize voltage, capacity, size, chemistry (alkaline, silver-oxide, lithium, NiMH) and connectors. Send us your spec and we confirm feasibility.' },
];

const caps = [
  { c: 'Voltage & capacity', d: 'Custom output and capacity to your load' },
  { c: 'Cell chemistry', d: 'Alkaline, silver-oxide, lithium & NiMH' },
  { c: 'Size & shape', d: 'Button, cylindrical & custom packs' },
  { c: 'Connectors & housings', d: 'Terminals, holders and custom enclosures' },
  { c: 'Brand label & packaging', d: 'Logo, blister, card and box — retail-ready' },
  { c: 'Child-resistant & blister', d: 'Safe and compliant retail packaging' },
  { c: 'Battery pack & BMS', d: 'Custom packs, spot weld, electronics & BMS' },
];

const steps = [
  { n: '1', t: 'Step 1: Specification & Customization', d: 'Tell us voltage, capacity, size, chemistry, connector and packaging needs. We confirm a clear spec sheet before build.' },
  { n: '2', t: 'Step 2: Prototyping & Testing', d: 'We build and test a sample to your spec — capacity, internal resistance and cycle checks before production.' },
  { n: '3', t: 'Step 3: Custom Packaging & Labeling', d: 'Custom blister, box and brand label with your logo, plus child-resistant and retail-ready options.' },
  { n: '4', t: 'Step 4: Mass Production & QC', d: 'Factory-direct mass production with ISO 9001 QC and batch inspection before shipping.' },
];

const chem = [
  { n: 'Alkaline (Zn-MnO₂)', d: 'LR44/AG13, AA/AAA/D, 1.5V, 0% mercury.' },
  { n: 'Silver Oxide (AgO)', d: 'SR626, SR44, 377, 371, 364 — 1.55V steady output.' },
  { n: 'Lithium (Li-MnO₂)', d: 'CR2032, CR2025, CR2016, CR2450 & more — 3V, high energy.' },
  { n: 'NiMH Rechargeable', d: 'Rechargeable AA/AAA and packs, long cycle life.' },
];

const industries = [{n:'Car key fobs',img:'/images/hero-keyfob.jpg'},{n:'Watches',img:'/images/hero-watch.jpg'},{n:'Medical devices',img:'/images/ind-medical.jpg'},{n:'Smart locks',img:'/images/ind-smartlock.jpg'},{n:'Remote controls',img:'/images/ind-remote.jpg'},{n:'Motherboards',img:'/images/hero-cmos.jpg'},{n:'Toys',img:'/images/ind-toys.jpg'},{n:'Energy storage',img:'/images/hero-pack.jpg'},{n:'Hearing aids',img:'/images/ind-hearing.jpg'}];

const moqRows = [
  { line: 'Button cells (CR / AG / SR)', moq: 'From 10,000 pcs', lead: 'Flexible for OEM & private label' },
  { line: 'AA / AAA alkaline', moq: 'From 10,000 pcs', lead: 'High-volume, fast turnaround' },
  { line: 'D / C carbon-zinc', moq: 'From 5,000 pcs', lead: 'Industrial & heavy-duty' },
  { line: 'Rechargeable NiMH / PACK', moq: 'Project-based', lead: 'Custom design & BMS' },
];

const whyUs = [
  { i: 'fa-award', t: 'Licensed OEM', d: 'Authorized manufacturer for PHILIPS, MITSUBISHI, SEIZI & SOXEY.' },
  { i: 'fa-industry', t: '100,000 m² factory', d: 'Tianqiu Industrial Park with Japanese fully-automatic lines and 500+ staff.' },
  { i: 'fa-flag', t: '31+ years', d: 'Founded 1994, exporting to a global network of countries.' },
  { i: 'fa-shield-halved', t: 'Certified & compliant', d: 'ISO 9001 · ISO 45001 · BSCI · UL · UN38.3 · CE · RoHS · SGS.' },
  { i: 'fa-boxes-stacked', t: '500+ product types', d: 'From button cells to cylindrical cells and battery packs.' },
  { i: 'fa-handshake', t: 'Factory-direct pricing', d: 'No middleman — OEM pricing straight from the source.' },
];

const custOptions = ['Voltage','Capacity','Size / shape','Connector','Brand label','Packaging','BMS / cell type'];

const schema = [
  { '@context': 'https://schema.org', '@type': 'Service',
    name: 'Battery OEM / ODM Manufacturing',
    serviceType: 'Battery OEM/ODM Manufacturing — custom voltage, capacity, chemistry, label & packaging',
    provider: { '@type': 'Organization', name: brand.nameFull, url: brand.domain },
    description: description },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---

<Layout title={title} description={description} schema={schema} breadcrumbs={crumbs}>
  <div class="container breadcrumb"><a href="/">Home</a> <span>/</span> <a href="/oem-battery-manufacturing/">Battery OEM / ODM Manufacturing</a></div>

  <!-- HERO -->
  <section class="hero hero-oem">
    <div class="hero-content" style="justify-content:flex-start;">
      <div style="max-width:720px;width:100%;text-align:left;">
        <div class="eyebrow left">OEM / ODM Factory</div>
        <h1 style="font-size:clamp(36px,4.3vw,56px);color:#fff;max-width:19ch;margin-bottom:14px;">Battery OEM / ODM Manufacturing Services</h1>
        <p class="lead" style="font-size:19px;color:#dce8f5;max-width:50ch;margin-bottom:26px;">From a single spec to a finished branded battery — TIANQIU does it all in one certified factory. 31+ years, licensed OEM for global brands.</p>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:16px;max-width:560px;margin-bottom:28px;">
          <div style="border-left:3px solid #6fa8ff;padding-left:12px;"><div style="font-size:28px;font-weight:900;color:#fff;">31+</div><div style="font-size:12px;color:#b9c9dd;">Years</div></div>
          <div style="border-left:3px solid #6fa8ff;padding-left:12px;"><div style="font-size:28px;font-weight:900;color:#fff;">100k㎡</div><div style="font-size:12px;color:#b9c9dd;">Factory</div></div>
          <div style="border-left:3px solid #6fa8ff;padding-left:12px;"><div style="font-size:28px;font-weight:900;color:#fff;">500+</div><div style="font-size:12px;color:#b9c9dd;">Products</div></div>
          <div style="border-left:3px solid #6fa8ff;padding-left:12px;"><div style="font-size:28px;font-weight:900;color:#fff;">UL</div><div style="font-size:12px;color:#b9c9dd;">Certified</div></div>
        </div>
        <div style="display:flex;gap:14px;flex-wrap:wrap;">
          <a href="#quote" class="btn btn-primary btn-lg">Start Your Custom Battery Project</a>
          <a href="/battery-certifications/" class="btn btn-outline btn-lg">View Certifications</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Complete OEM Solutions -->
  <section class="section reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Turnkey OEM</div><h2>Complete OEM Battery Solutions — From Spec to Shelf</h2><p class="lead">One certified factory handles everything: specification, sampling, custom label and retail-ready packaging, then high-volume mass production with strict QC. Send us a spec and we deliver a finished, branded battery to your door.</p></div>
      <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(250px,1fr));">
        {[{i:'fa-gears',t:'Custom Cells',d:'Voltage, capacity, chemistry & size built to your spec.'},{i:'fa-tags',t:'Custom Label',d:'Your brand on the cell, blister and box.'},{i:'fa-box-open',t:'Retail-Ready',d:'Blister, box and child-resistant packaging.'},{i:'fa-globe',t:'Global Shipping',d:'Maritime &amp; air transport certified worldwide.'}].map(x=>(<div class="feature"><div class="feat-icon"><i class={`fa-solid ${x.i}`}></i></div><h3>{x.t}</h3><p>{x.d}</p></div>))}
      </div>
    </div>
  </section>

  <!-- Manufacturing Process (4 Steps) -->
  <section class="section section-alt reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Our Process</div><h2>Our OEM Manufacturing Process</h2><p class="lead">A proven 4-step route from your requirement to a certified, branded mass production run.</p></div>
      <div class="steps-grid">
        {steps.map(s=>(<div class="step"><div class="sn">{s.n}</div><h4>{s.t}</h4><p>{s.d}</p></div>))}
      </div>
    </div>
  </section>

  <!-- Customization capability -->
  <section class="section reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Customization</div><h2>What We Can Customize</h2><p class="lead">Everything below is fully configurable to your project, from a single spec to a branded product line.</p></div>
      <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(280px,1fr));">
        {caps.map(c=>(<div class="card"><div class="feat-icon" style="width:44px;height:44px;font-size:18px;"><i class="fa-solid fa-sliders"></i></div><h3>{c.c}</h3><p>{c.d}</p></div>))}
      </div>
    </div>
  </section>

  <!-- Chemistries -->
  <section class="section section-alt reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Chemistry</div><h2>Battery Chemistries We Can Customize</h2><p class="lead">Choose the chemistry that matches your device, cost target and performance requirement.</p></div>
      <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(250px,1fr));">
        {chem.map(c=>(<div class="card"><div class="feat-icon"><i class="fa-solid fa-battery-half"></i></div><h3>{c.n}</h3><p>{c.d}</p></div>))}
      </div>
    </div>
  </section>

  <!-- Packaging showcase -->
  <section class="section reveal">
    <div class="container">
      <div class="cols2" style="align-items:center;">
        <div class="img-wrap" style="background:var(--surface-alt);border:1px solid var(--border-light);border-radius:20px;overflow:hidden;">
          <img src="/images/philips-power-alkaline.jpg" alt="OEM custom battery label and retail packaging" loading="lazy" onerror="this.style.opacity=.3" style="width:100%;object-fit:contain;max-height:360px;" />
        </div>
        <div>
          <div class="eyebrow left">Your Brand on Every Cell</div>
          <h2>Custom Label &amp; Retail-Ready Packaging</h2>
          <p class="lead">Put your logo on the cell and on the pack. We produce blister, card and box packaging — including child-resistant and retail-ready options — to your artwork.</p>
          <ul class="clean">
            <li>Custom logo &amp; brand printing on cell and packaging</li>
            <li>Blister, card and box formats, retail-ready</li>
            <li>Child-resistant &amp; compliance packaging (EU 2023/1542)</li>
          </ul>
          <div style="margin-top:22px;display:flex;gap:14px;flex-wrap:wrap;"><a href="#quote" class="btn btn-primary">Request Custom Packaging</a><a href="/wholesale-batteries/" class="btn btn-outline">Wholesale Supply</a></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="section section-alt reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Industries</div><h2>Industries We Supply</h2><p class="lead">The right cell for every application — from consumer to industrial, powered by a single certified supplier.</p></div>
      <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(180px,1fr));">
        {industries.map(i=>(<div class="card" style="text-align:center;padding:0;overflow:hidden;border:1px solid var(--border-light);" >{i.img ? <img src={i.img} alt={i.n} loading="lazy" style="width:100%;height:120px;object-fit:cover;display:block;"/> : <div class="feat-icon" style="width:100%;height:120px;border-radius:0;justify-content:center;align-items:center;"><i class={`fa-solid ${i.ic}`}></i></div>}<div style="padding:12px 14px;font-weight:600;font-size:16px;color:var(--ink);">{i.n}</div></div>))}
      </div>
      <div style="margin-top:28px;text-align:center;">
        <a href="/battery-pack/" class="btn btn-outline">Custom Battery Pack</a>
        <a href="/wholesale-batteries/" class="btn btn-outline">Bulk Supply</a>
      </div>
    </div>
  </section>

  <!-- Certifications -->
  <section class="section reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Trust &amp; Compliance</div><h2>Certifications &amp; Compliance</h2><p class="lead">Every TIANQIU battery ships with the documentation your project and freight forwarder need.</p></div>
      <div style="display:flex;gap:12px;flex-wrap:wrap;">
        {company.certifications.map(c=>(<span class="badge" style="font-size:16px;padding:10px 20px;"><i class="fa-solid fa-badge-check"></i>{c}</span>))}
      </div>
      <p style="margin-top:20px;color:var(--ink-2);font-size:15px;">IEC 60086 · EU Regulation 2023/1542 · maritime &amp; air transport certification for safe shipping worldwide.</p>
      <div style="margin-top:22px;"><a href="/battery-certifications/" class="btn btn-primary">View Certification Details</a></div>
    </div>
  </section>

  <!-- MOQ / Pricing / Lead Time -->
  <section class="section section-alt reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">MOQ &amp; Lead Time</div><h2>MOQ, Pricing &amp; Lead Time</h2><p class="lead">Volume pricing is quoted per project. Tell us your timeline and we confirm the lead time in the quote.</p></div>
      <div style="overflow-x:auto;background:#fff;border:1px solid var(--border-light);border-radius:14px;padding:0 8px;">
        <table>
          <thead><tr><th>Product Line</th><th>MOQ</th><th>Notes</th></tr></thead>
          <tbody>{moqRows.map(m=>(<tr><td><strong>{m.line}</strong></td><td>{m.moq}</td><td>{m.lead}</td></tr>))}</tbody>
        </table>
      </div>
      <div style="margin-top:20px;display:flex;gap:12px;flex-wrap:wrap;"><a href="#quote" class="btn btn-primary">Get a Quote</a><a href="/wholesale-batteries/" class="btn btn-outline">Wholesale Pricing</a></div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="section reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Why TIANQIU</div><h2>Why Choose Us as Your Battery OEM Partner</h2><p class="lead">A factory partner with the licenses, certifications and capacity to back your brand at scale.</p></div>
      <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(300px,1fr));">
        {whyUs.map(w=>(<div class="card"><div class="feat-icon"><i class={`fa-solid ${w.i}`}></i></div><h3>{w.t}</h3><p>{w.d}</p></div>))}
      </div>
    </div>
  </section>

  <!-- Authorized OEM -->
  <section class="section section-alt reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Trusted by Global Brands</div><h2>An Authorized OEM for Leading Names</h2><p class="lead">We manufacture and distribute under license for globally recognized brands — proof of our quality and compliance.</p></div>
      <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(250px,1fr));">
        {company.partners.map(p=>(<div class="card" style="text-align:center;"><div style="font-size:22px;font-weight:700;color:var(--primary);margin-bottom:6px;">{p.name}</div><div style="font-size:14px;color:var(--ink-3);">{p.type}</div><p style="font-size:15px;margin-top:8px;color:var(--ink-2);">{p.desc}</p></div>))}
      </div>
    </div>
  </section>

  <!-- Quote form -->
  <section class="section reveal" id="quote">
    <div class="container" style="max-width:840px;">
      <div class="headline-group hl-center"><div class="eyebrow">Get a Quote</div><h2>Start Your Custom Battery Project</h2><p class="lead">Tell us your spec — voltage, capacity, size, label &amp; packaging. We reply with a full quote and timeline.</p></div>
      <form action="https://web3forms.com/submit" method="POST" id="quoteForm">
        <input type="hidden" name="access_key" value="a532024b-8305-428d-a12e-5fcc5958d36a" />
        <input type="hidden" name="subject" value="New Battery OEM / ODM Inquiry" />
        <div class="form-row"><label>Name *</label><input type="text" name="name" required /></div>
        <div class="form-row"><label>Email *</label><input type="email" name="email" required /></div>
        <div class="form-row"><label>Company</label><input type="text" name="company" /></div>
        <div class="form-row"><label>Battery product type *</label><input type="text" name="battery_type" placeholder="e.g. CR2032, AA alkaline, custom pack" required /></div>
        <div class="form-row"><label>Estimated annual quantity</label><input type="text" name="annual_quantity" placeholder="e.g. 500,000 pcs / year" /></div>
        <div class="form-row"><label>Customization needed</label>
          <div style="display:flex;gap:10px;flex-wrap:wrap;">{custOptions.map(c=>(<label style="display:flex;align-items:center;gap:6px;font-size:14px;"><input type="checkbox" name="customization" value={c} /> {c}</label>))}</div>
        </div>
        <div class="form-row"><label>Target market</label><input type="text" name="target_market" placeholder="e.g. USA, Europe" /></div>
        <div class="form-row"><label>Your requirements *</label><textarea name="message" rows="4" required placeholder="Voltage, capacity, size, connector, label & packaging needs..."></textarea></div>
        <div class="form-row"><label>Upload drawings / specs (optional)</label><input type="file" name="drawings" /></div>
        <button class="btn btn-primary btn-block" type="submit">Request a Quote</button>
        <p id="formMsg" style="margin-top:14px;font-size:14px;"></p>
      </form>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-alt reveal">
    <div class="container container-narrow">
      <div class="headline-group"><div class="eyebrow">FAQ</div><h2>OEM Battery FAQs</h2></div>
      {faqs.map(f=>(<details><summary>{f.q}</summary><div class="a">{f.a}</div></details>))}
    </div>
  </section>

<script is:inline>
  (()=>{const els=document.querySelectorAll('.reveal');if(!('IntersectionObserver' in window)){els.forEach(e=>e.classList.add('in'));return;}const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.12});els.forEach(e=>io.observe(e));})();
  document.querySelectorAll('[data-count]').forEach(el=>{const t=parseFloat(el.dataset.count),suf=el.dataset.suffix||'',dur=1400,st=performance.now();function step(n){const pr=Math.min((n-st)/dur,1),e=1-Math.pow(1-pr,3);el.textContent=Math.round(t*e)+suf;if(pr<1)requestAnimationFrame(step);}requestAnimationFrame(step);});
</script>

</Layout>

<script is:inline>
  document.getElementById('quoteForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target, msg = document.getElementById('formMsg');
    const btn = form.querySelector('button[type=submit]');
    btn.disabled = true; btn.textContent = 'Sending...';
    try {
      const r = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const data = await r.json();
      if (data.success) { msg.textContent = 'Thank you! Your inquiry has been sent. Our team will reply shortly.'; form.reset(); }
      else { msg.textContent = 'Sorry, something went wrong. Please try again or email us directly.'; }
    } catch (err) { msg.textContent = 'Network error. Please try again.'; }
    btn.disabled = false; btn.textContent = 'Request a Quote';
  });
</script>
