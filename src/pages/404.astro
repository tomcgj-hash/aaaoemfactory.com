---
import Layout from '../layouts/Layout.astro';
const title = 'Page Not Found | TIANQIU';
---
<Layout title={title} description="Page not found.">
  <section class="hero hero-eco"><div class="container" style="max-width:620px;text-align:center;">
    <div style="font-size:72px;font-weight:700;color:var(--primary);line-height:1;">404</div>
    <h1 style="margin-top:12px;">Page Not Found</h1>
    <p class="lead" style="margin:0 auto 24px;">The page you're looking for doesn't exist. Let's get you back on track.</p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;"><a href="/" class="btn btn-primary">Back to Home</a><a href="/button-cell-battery/" class="btn btn-outline">Browse Products</a></div>
  </div></section>
</Layout>
