---
import Layout from '../layouts/Layout.astro';
const title = 'Search | TIANQIU Battery';
const description = 'Search TIANQIU battery models, guides, OEM/ODM info and more — find the cell, spec or guide you need.';
const crumbs = [{ name:'Home', url:'/' }, { name:'Search', url:'/search/' }];
const categories = [
  { n:'Button / Coin Cells', url:'/button-cell-battery/' },
  { n:'AA Batteries', url:'/aa-battery/' },
  { n:'AAA Batteries', url:'/aaa-battery/' },
  { n:'C & D / 9V', url:'/d-battery/' },
  { n:'Battery Packs', url:'/battery-pack/' },
  { n:'OEM / ODM', url:'/oem-battery-manufacturing/' },
];
const popular = [
  ['CR2032','cr2032'],['CR2025','cr2025'],['CR2450','cr2450'],['LR44','lr44'],['LR41','lr41'],['LR6','lr6'],['LR03','lr03'],['6LR61','6lr61'],
];
const questions = [
  ['How to choose a battery?','/blog/button-cell-battery-guide/'],
  ['Which coin cell do I need?','/blog/cr2032-vs-cr2025-vs-cr2016/'],
  ['What is the MOQ?','/oem-battery-manufacturing/#faq'],
  ['How does OEM work?','/oem-battery-manufacturing/#process'],
];
const chips = ['CR2032','Button cell','AA battery','Watch battery','OEM battery','Which battery','How long do batteries last','Wholesale'];
---
<Layout title={title} description={description} breadcrumbs={crumbs}>
  <div class="container breadcrumb"><a href="/">Home</a> <span>/</span> Search</div>
  <section class="hero hero-industrial"><div class="container" style="max-width:920px;text-align:center;">
    <div class="eyebrow">Search</div>
    <h1>Search TIANQIU</h1>
    <p class="lead">Find battery models, specs, OEM info and guides — everything in one place.</p>
  </div></section>

  <section class="section reveal"><div class="container" style="max-width:780px;">
    <div id="search-page" style="position:relative;"></div>
    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:24px;justify-content:center;">
      {chips.map(c=>(<button class="badge search-chip" data-q={c} style="cursor:pointer;font-size:14px;padding:10px 18px;">{c}</button>))}
    </div>

    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:18px;margin-top:44px;">
      <div class="card" style="padding:24px;"><div class="eyebrow">Browse by category</div>
        <div style="display:grid;gap:10px;margin-top:14px;">{categories.map(c=>(<a href={c.url} style="color:var(--ink);font-weight:600;font-size:15px;display:flex;justify-content:space-between;"><span>{c.n}</span><span style="color:var(--primary);">→</span></a>))}</div>
      </div>
      <div class="card" style="padding:24px;"><div class="eyebrow">Popular models</div>
        <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:14px;">{popular.map(([n,slug])=>(<a href={`/battery-type/${slug}-battery/`} class="badge" style="font-size:14px;font-weight:700;">{n}</a>))}</div>
      </div>
      <div class="card" style="padding:24px;"><div class="eyebrow">Popular questions</div>
        <div style="display:grid;gap:10px;margin-top:14px;">{questions.map(([q,u])=>(<a href={u} style="color:var(--ink);font-weight:600;font-size:15px;display:flex;justify-content:space-between;"><span>{q}</span><span style="color:var(--primary);">→</span></a>))}</div>
      </div>
    </div>
  </div></section>

<script>
  import { PagefindUI } from '@pagefind/default-ui';
  import '@pagefind/default-ui/css/ui.css';
  new PagefindUI({ element:'#search-page', showSubResults:false, showImages:false, pageSize:8, showEmptyFilters:false, translations:{ placeholder:'Search battery models, guides, pages\u2026' } });
  document.querySelectorAll('.search-chip').forEach(function(b){ b.addEventListener('click',function(){ var inp=document.querySelector('#search-page .pagefind-ui__search-input'); if(inp){ inp.value=b.getAttribute('data-q'); inp.dispatchEvent(new Event('input',{bubbles:true})); inp.focus(); } }); });
</script>
</Layout>
