---
const factoryImgs=["f0.jpg", "f1.jpg", "f2.jpg", "f3.jpg", "f4.jpg", "f5.jpg", "f6.jpg", "f7.jpg", "f8.jpg"];
const gCerts=["global-certs/cert-tm0.jpg", "global-certs/cert-tm1.jpg", "global-certs/cert-tm2.jpg", "global-certs/cert-tm3.jpg", "global-certs/cert-tm4.jpg", "global-certs/cert-tm5.jpg", "global-certs/cert-tm6.jpg", "global-certs/cert-tm7.jpg", "global-certs/cert-tm8.jpg", "global-certs/cert-tm9.jpg"];;
const certImgs=["c0.jpg", "c1.jpg", "c2.jpg", "c3.jpg", "c4.jpg", "c5.jpg", "c6.jpg", "c7.jpg", "c8.jpg", "c9.jpg", "c10.jpg"];;
import Layout from '../layouts/Layout.astro';
import { productLines, productLines as pl } from '../data/productLines.js';
import { company } from '../data/company.js';
import { brand } from '../data/brand.js';
const title = 'Battery OEM Manufacturer & Custom Battery Solutions - AA, AAA, Button Cell & PACK | TIANQIU';
const description = 'China battery OEM manufacturer: custom AA, AAA, D, button cell & battery pack. OEM/ODM from spec to packaging. UL/UN38.3 certified. Licensed OEM for global brands.';
const ws = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: 'TIANQIU', url: brand.domain }];
const stats = [
  { n: '31', l: 'Years making batteries' },
  { n: '100,000 m²', l: 'One factory' },
  { n: '500+', l: 'Product types' },
  { n: `${company.exports.length}+`, l: 'Countries shipped to' },
];
// Non-symmetric hero product features — real photos, no icon cards
const features = [
  { flip:false, img:'/images/lithium-button-cell-pack.jpg', kw:'Button cells', name:'CR2032, LR44, SR626', text:'The coin cells behind car key fobs, watches, motherboards and the Apple AirTag. 26 interchangeable models, 0% mercury.', url:'/button-cell-battery/', cta:'Browse button cells' },
  { flip:true, img:'/images/philips-power-alkaline.jpg', kw:'Alkaline', name:'The AA your brand sells', text:'2,150–2,600 mAh alkaline AA and AAA, poured on a Japanese MITSUBISHI line and wrapped in your label.', url:'/aa-battery/', cta:'See AA & AAA' },
  { flip:false, img:'/images/rechargeable-nimh.jpg', kw:'Rechargeable & packs', name:'Cells that can take a charge', text:'NiMH AA/AAA plus lithium modules and custom packs — a real cycle-life spec, not a vague promise.', url:'/rechargeable-battery/', cta:'See rechargeable' },
];
const factory = [
  { n:'100,000 m²', l:'Industrial park' },
  { n:'RMB 1.5 bn', l:'Investment' },
  { n:'500+', l:'Staff' },
  { n:'31 yrs', l:'Since 1994' },
];
const why = [
  { n:'26', l:'Interchangeable button-cell models' },
  { n:'30+', l:'Countries on our export list' },
  { n:'3', l:'Japanese & European license partners' },
  { n:'0%', l:'Mercury in our alkaline button cells' },
];
const industries = [{n:'Car key fobs',img:'/images/hero-keyfob.jpg'},{n:'Watches',img:'/images/hero-watch.jpg'},{n:'Motherboards',img:'/images/hero-cmos.jpg'},{n:'Medical devices',img:'/images/ind-medical.jpg'},{n:'Smart locks',img:'/images/ind-smartlock.jpg'},{n:'Toys',img:'/images/ind-toys.jpg'},{n:'Hearing aids',img:'/images/ind-hearing.jpg'},{n:'IoT & sensors',img:'/images/ind-iot.jpg'},{n:'Energy storage',img:'/images/hero-pack.jpg'}];
---
<Layout title={title} description={description} schema={ws}>
  <!-- HERO — real photo + frosted card (kept) -->
  <section class="hero hero-home">
    <div class="hero-content">
      <div class="hero-card">
        <div class="eyebrow">Battery manufacturer &amp; licensed OEM</div>
        <h1 style="font-size:clamp(28px,3.6vw,44px);line-height:1.12;letter-spacing:-.01em;margin-bottom:18px;">Custom batteries, engineered to your brand.</h1>
        <p class="lead" style="font-size:16px;line-height:1.6;max-width:54ch;margin-bottom:26px;">We make the cells, wrap them and ship them under your name — the same way we do for PHILIPS, MITSUBISHI, SEIZI &amp; SOXEY.</p>
        <div style="display:flex;gap:14px;flex-wrap:wrap;">
          <a href="/contact-us/" class="btn btn-primary btn-lg">Start Your Project</a>
          <a href="/oem-battery-manufacturing/" class="btn btn-outline btn-lg">OEM Service</a>
        </div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:26px;padding-top:20px;border-top:1px solid rgba(255,255,255,.16);">
          {stats.map(s=>(<div><div style="font-size:19px;font-weight:800;color:#fff;line-height:1.2;">{s.n}</div><div style="font-size:11px;color:rgba(255,255,255,.7);margin-top:3px;line-height:1.3;">{s.l}</div></div>))}
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCTS — non-symmetric real-photo rows -->
  <section class="section reveal" style="padding-top:28px;">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">What we build</div><h2>Batteries, poured on a real line.</h2></div>
      {features.map(f=>(
        <div class="cols2" style="align-items:center;margin-bottom:56px;">
          <div class="reveal" style={f.flip?'order:2':''}><img src={f.img} alt={f.name} loading="lazy" onerror="this.style.opacity=.3" style="width:100%;border-radius:18px;object-fit:cover;aspect-ratio:3/2;border:1px solid var(--border-light);box-shadow:var(--shadow-sm);" /></div>
          <div class="reveal" style={f.flip?'order:1':''}>
            <div class="eyebrow left">{f.kw}</div>
            <h3 style="font-size:34px;margin-bottom:12px;font-weight:900;">{f.name}</h3>
            <p class="lead" style="font-size:18px;margin-bottom:22px;">{f.text}</p>
            <a href={f.url} class="btn btn-outline">{f.cta} →</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- FACTORY — image + text + numbers (split, soft bg) -->
  <section class="section reveal" style="background:var(--soft);">
    <div class="container">
      <div class="cols2" style="align-items:center;gap:44px;">
        <div class="reveal"><img src="/images/hero-industrial.jpg" alt="TIANQIU 100,000 m² battery factory" loading="eager" style="width:100%;height:auto;object-fit:contain;border-radius:18px;border:1px solid var(--border-light);box-shadow:var(--shadow-sm);" /></div>
        <div class="reveal">
          <div class="eyebrow">The factory</div>
          <h2 style="font-size:clamp(36px,4.3vw,56px);line-height:1.08;">One factory, end to end.</h2>
          <p class="lead" style="font-size:18px;margin-top:14px;">From raw materials to a finished battery in your brand's wrapper — poured, tested and shipped under one roof. That's how global brands keep their supply simple.</p>
          <div style="display:flex;gap:32px;margin-top:24px;flex-wrap:wrap;">
            {factory.map(f=>(<div><div style="font-size:34px;font-weight:900;color:var(--primary);line-height:1;">{f.n}</div><div style="font-size:13px;color:var(--ink-2);margin-top:6px;">{f.l}</div></div>))}
          </div>
          <a href="/about-us/" class="btn btn-primary" style="margin-top:28px;">About Our Factory</a>
        </div>
      </div>
    </div>
<div class="section reveal"><div class="container"><div class="headline-group"><div class="eyebrow">Real plant</div><h2>Inside the factory floor</h2></div><p class="lead">A look at where TIANQIU cells are poured, printed and packed.</p><div style="display:grid;grid-template-columns:repeat(12,1fr);gap:10px;margin-top:18px;">
        <img src={"/images/factory/"+factoryImgs[0]} alt="TIANQIU battery production line" loading="lazy" style="grid-column:1/-1;width:100%;aspect-ratio:16/8;object-fit:cover;border:2px solid #c9a227;border-radius:3px;"/>
        {factoryImgs.slice(1).map(f=>(<img src={"/images/factory/"+f} alt="TIANQIU factory" loading="lazy" style="grid-column:span 3;width:100%;aspect-ratio:4/3;object-fit:cover;border:2px solid #c9a227;border-radius:3px;"/>))}
      </div></div></div>

  </section>

  <!-- GLOBAL SERVICE NETWORK -->
  <section class="section reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Global service</div><h2>TIANQIU Global Service Network</h2><p class="lead">We ship to buyers across 6 continents &mdash; with the U.S., Germany, Turkey, Spain, Brazil, Italy, South Korea, Dubai, Saudi Arabia and South Africa as our key export windows.</p></div>
      <img src="/images/global-network.jpg" alt="TIANQIU global service network world map" loading="lazy" style="width:100%;border-radius:18px;border:1px solid var(--border-light);box-shadow:var(--shadow-sm);" />
      <div style="margin-top:34px;text-align:center;"><div style="font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-2);font-weight:700;">Global trademarks &amp; registrations</div></div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:16px;margin-top:16px;max-width:960px;margin-left:auto;margin-right:auto;">{gCerts.map(c=>(<div style="background:#fff;border-radius:12px;padding:10px;border:1px solid var(--border-light);box-shadow:var(--shadow-sm);"><img src={"/images/"+c} alt="TIANQIU international trademark registration" loading="lazy" style="width:100%;aspect-ratio:3/4;object-fit:contain;border-radius:6px;"/></div>))}</div></div>
  </section>
  <!-- WHY — numbers, no icon cards -->
  <section class="section reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Why TIANQIU</div><h2>Numbers a buyer can check.</h2></div>
      <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:28px;border-top:1px solid var(--border-light);padding-top:28px;">
        {why.map(w=>(<div><div style="font-size:50px;font-weight:900;color:var(--primary);line-height:1;letter-spacing:-.03em;">{w.n}</div><div style="font-size:15px;color:var(--ink-2);margin-top:10px;">{w.l}</div></div>))}
      </div>
      <p class="lead" style="margin-top:30px;font-size:18px;">Certified: ISO 9001 · ISO 45001 · BSCI · UL · UN38.3 · CE · RoHS · EU 2023/1542. The paperwork your compliance team asks for — it exists.</p>
    </div>
  </section>

  <!-- INDUSTRIES -->
  <section class="section section-alt reveal">
    <div class="container">
      <div class="headline-group hl-center"><div class="eyebrow">Industries</div><h2>Where our cells end up</h2></div>
      <div style="display:flex;gap:12px;flex-wrap:wrap;justify-content:center;">
        {industries.map(i=>(<div class="card" style="text-align:center;padding:0;overflow:hidden;border:1px solid var(--border-light);">{i.img ? <img src={i.img} alt={i.n} loading="lazy" style="width:100%;height:110px;object-fit:cover;display:block;"/> : <div class="feat-icon" style="width:100%;height:110px;border-radius:0;justify-content:center;"><i class={`fa-solid ${i.ic}`}></i></div>}<div style="padding:10px;font-weight:600;font-size:15px;color:var(--ink);">{i.n}</div></div>))}
      </div>
    </div>
  </section>

  <!-- AUTHORIZED + CERTIFICATION — dark trust wall -->
  <section class="section reveal" style="background:linear-gradient(135deg,#12233c,#1b3a6b);">
    <div class="container">
      <div class="headline-group hl-center"><div class="eyebrow" style="color:#ffd8a8;">Authorized &amp; certified</div><h2 style="color:#fff;">Licenses and certificates, not claims.</h2><p class="lead" style="color:#cfe0f5;max-width:62ch;">We manufacture under license for globally recognized brands and hold the certifications your compliance team asks for — they exist.</p></div>

      <div style="display:flex;gap:18px;flex-wrap:wrap;justify-content:center;margin-top:30px;">
        <div class="card" style="padding:14px;max-width:300px;background:#fff;"><img src="/images/partner-philips-mitsubishi.jpg" alt="PHILIPS &amp; MITSUBISHI authorization letters" loading="lazy" style="width:100%;max-height:170px;object-fit:contain;border-radius:8px;"><p style="font-size:13px;color:var(--ink-2);margin-top:8px;text-align:center;">PHILIPS &amp; MITSUBISHI authorization</p></div>
        <div class="card" style="padding:14px;max-width:300px;background:#fff;"><img src="/images/partner-seizi-authorization.jpg" alt="SEIZI Japan exclusive agency agreement" loading="lazy" style="width:100%;max-height:170px;object-fit:contain;border-radius:8px;"><p style="font-size:13px;color:var(--ink-2);margin-top:8px;text-align:center;">SEIZI (Japan) exclusive agency</p></div>
      </div>
      <div style="margin-top:34px;text-align:center;"><div style="font-size:13px;letter-spacing:.14em;text-transform:uppercase;color:#9fb8dd;font-weight:700;">Certification library</div><div style="font-size:13px;color:#cfe0f5;margin-top:4px;">ISO &middot; CE &middot; UL &middot; UN38.3 &middot; RoHS &middot; IEC — the certificates we actually hold</div></div>
      <div style="display:flex;gap:12px;overflow-x:auto;padding:10px 2px 14px;margin-top:16px;scroll-snap-type:x proximity;scrollbar-width:thin;">
        {certImgs.map(f=>(<div style="scroll-snap-align:center;flex:0 0 150px;background:#fff;border-radius:10px;padding:8px;box-shadow:0 2px 12px rgba(0,0,0,.14);"><img src={"/images/cert/"+f} alt="TIANQIU certification" loading="lazy" style="width:100%;aspect-ratio:1.3/1;object-fit:contain;border-radius:6px;"/></div>))}
      </div>
      <div style="text-align:center;margin-top:16px;"><a href="/battery-certifications/" class="btn" style="background:#fff;color:var(--primary);">All Certifications</a></div>
      <div style="margin-top:26px;display:flex;gap:12px;flex-wrap:wrap;justify-content:center;">
        {company.certifications.map(c=>(<span class="badge" style="font-size:14px;font-weight:600;background:rgba(255,255,255,.12);color:#fff;border:1px solid rgba(255,255,255,.28);"><i class="fa-solid fa-badge-check"></i>{c}</span>))}
      </div>
      <div style="display:flex;gap:22px;flex-wrap:wrap;justify-content:center;margin-top:28px;color:#fff;font-size:14px;font-weight:600;">
        <span><i class="fa-solid fa-flask-vial" style="color:#ffd8a8;margin-right:6px;"></i>Samples available</span>
        <span><i class="fa-solid fa-boxes-stacked" style="color:#ffd8a8;margin-right:6px;"></i>MOQ from 10,000</span>
        <span><i class="fa-solid fa-clock" style="color:#ffd8a8;margin-right:6px;"></i>Lead time confirmed</span>
        <span><i class="fa-solid fa-bolt" style="color:#ffd8a8;margin-right:6px;"></i>24h response</span>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section class="section section-alt reveal">
    <div class="container">
      <div class="cols2" style="align-items:center;">
        <div>
          <div class="eyebrow left">Start a project</div>
          <h2>Tell us the cell. We'll build it.</h2>
          <p class="lead" style="font-size:18px;margin-bottom:24px;">Send voltage, capacity, size and your logo — we'll quote it, sample it and scale it.</p>
          <div class="contact-item"><div class="ci"><i class="fa-solid fa-envelope"></i></div><div><div class="l">Email</div><div class="v">{brand.email}</div></div></div>
          <div class="contact-item"><div class="ci"><i class="fa-solid fa-phone"></i></div><div><div class="l">Phone / WhatsApp</div><div class="v">{brand.phone}</div></div></div>
          <div style="margin-top:22px;"><a href="/contact-us/" class="btn btn-primary">Contact Us</a></div>
        </div>
        <div class="panel reveal">
          <form action="https://api.web3forms.com/submit" method="POST" id="homeForm">
            <input type="hidden" name="access_key" value="a532024b-8305-428d-a12e-5fcc5958d36a" />
            <div class="form-row"><label>Name *</label><input type="text" name="name" required /></div>
            <div class="form-row"><label>Email *</label><input type="email" name="email" required /></div>
            <div class="form-row"><label>Message *</label><textarea name="message" rows="4" required placeholder="Your battery requirements..."></textarea></div>
            <button class="btn btn-primary btn-block" type="submit">Send Inquiry</button>
            <p id="homeMsg" style="margin-top:12px;font-size:14px;"></p>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
<script is:inline>
  (()=>{ const els=document.querySelectorAll('.reveal'); if(!('IntersectionObserver' in window)){els.forEach(e=>e.classList.add('in'));return;}
    const io=new IntersectionObserver((es)=>{es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}});},{threshold:.12});
    els.forEach(e=>io.observe(e)); })();
  document.getElementById('homeForm').addEventListener('submit', async (e) => {
    e.preventDefault(); const f=e.target, m=document.getElementById('homeMsg');
    const b=f.querySelector('button'); b.disabled=true; b.textContent='Sending...';
    try{ const r=await (await fetch(f.action,{method:'POST',body:new FormData(f)})).json();
      if(r.success){ m.textContent='Thank you! Your inquiry has been sent.'; f.reset(); } else m.textContent='Please try again.'; }
    catch(err){ m.textContent='Network error. Please try again.'; }
    b.disabled=false; b.textContent='Send Inquiry';
  });
</script>
<script>document.querySelectorAll('form').forEach(function(f){ f.addEventListener('submit',function(){ document.querySelectorAll('input[name="subject"]').forEach(function(e){ e.value='来新询盘啦-'+location.href; }); }); });</script>