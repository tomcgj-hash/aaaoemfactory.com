---
import Layout from '../layouts/Layout.astro';
import { modelImages } from '../data/model_images.js';
import { aaLine } from '../data/models.js';
import { brand } from '../data/brand.js';
const appImg=(a)=>{const k=String(a).toLowerCase(); if(/(key fob|keyfob|vehicle|garage|code fob)/.test(k)) return "/images/hero-keyfob.jpg"; if(/(remote control|remote)/.test(k)) return "/images/ind-remote.jpg"; if(/(motherboard|cmos|computer|pc board)/.test(k)) return "/images/hero-cmos.jpg"; if(/(watch)/.test(k)) return "/images/hero-watch.jpg"; if(/(medical|thermometer|glucose|health|fever)/.test(k)) return "/images/ind-medical.jpg"; if(/(smart lock|\block\b)/.test(k)) return "/images/ind-smartlock.jpg"; if(/(toy|game)/.test(k)) return "/images/ind-toys.jpg"; if(/(hearing|ear)/.test(k)) return "/images/ind-hearing.jpg"; if(/(rfid|iot|sensor|meter|calculator|radio|flashlight|laser|micro|small|industrial|emergency|scales)/.test(k)) return "/images/ind-iot.jpg"; if(/(energy|storage|power|pack)/.test(k)) return "/images/hero-pack.jpg"; return null;};

// Real TIANQIU EU data (tianqiu_products.js)
const lr6 = {
  model: 'LR6 (AA)', name: 'LR6 Alkaline Zn-MnO₂ Cylindrical', voltage: '1.5V',
  capacity: '2150mAh ~ 2600mAh', shelf: 'Five years',
  perf: [
    ['Blue - Basic', '20.0g', '2150mAh', '38.0 hours'],
    ['Golden - Normal', '22.5g', '2400mAh', '45.0 hours'],
    ['Black - Extra', '23.0g', '2500mAh', '50.0 hours'],
    ['Ultral', '23.5g', '2600mAh', '55.5 hours'],
  ],
  note1: 'Capacity test condition: 43Ω 4h/day to 0.9V @ 20±2℃',
  note2: 'Digital audio duration condition: 50mA 1h/8h 24h/day to 1.0V @ 20±2℃',
  critical: 'Manganese, Graphite, Copper', docNo: 'TQ-EUDOC-LR6-20260622',
};
const r6p = {
  model: 'R6P (AA carbon)', voltage: '1.5V', capacity: '900mAh (1.35Wh)', shelf: 'Three years',
  perf: [
    ['PVC / Aluminum film', '13.5g', '900mAh', '27.0 hours'],
    ['Metal', '16.5g', '900mAh', '27.0 hours'],
  ],
  note1: 'Capacity & radio duration condition: 43Ω 4h/day to 0.9V @ 20±2℃',
  docNo: 'TQ-EUDOC-R6P-20260701',
};

const title = 'AA Batteries Manufacturer (LR6/R6) - Alkaline, Rechargeable & OEM | TIANQIU';
const description = 'AA batteries manufacturer: alkaline LR6 (2150-2600mAh) & carbon-zinc R6P. 0% mercury, 5-year shelf, OEM custom label & bulk from China factory.';
const crumbs = [{ name: 'Home', url: '/' }, { name: 'Batteries', url: '/aa-battery/' }, { name: 'AA Batteries (LR6)', url: '/aa-battery/' }];

const chemTable = [
  ['Alkaline (LR6)', '1.5V', '2150-2600mAh', '5-year shelf', '0% mercury'],
  ['Carbon Zinc (R6P)', '1.5V', '900mAh', '3-year shelf', 'Budget heavy-duty'],
  ['Rechargeable NiMH', '1.2V', 'Rechargeable', 'Long cycle life', 'Eco-friendly'],
];
const sizeTable = [
  ['AA (LR6)', '1.5V', '2150-2600mAh', 'Everyday, digital & high-drain'],
  ['AAA (LR03)', '1.5V', '1020-1260mAh', 'Remotes, small electronics'],
  ['D (LR20)', '1.5V', '18000mAh', 'Flashlights, industrial, emergency'],
];
const apps = ['Remote controls', 'Toys', 'Flashlights', 'Clocks', 'Game controllers', 'Portable audio'];

const faqs = [
  { q: 'What voltage is an AA battery?',
    a: `A fresh TIANQIU alkaline AA (LR6) is 1.5V nominal; a rechargeable NiMH AA runs at 1.2V.` },
  { q: 'What is the capacity of an AA battery?',
    a: `TIANQIU LR6 alkaline cells deliver 2150-2600mAh depending on grade (Blue/Golden/Black/Ultral), while a carbon-zinc R6P is 900mAh (1.35Wh).` },
  { q: 'How long does an AA battery last?',
    a: `An LR6 alkaline carries a 5-year shelf life and runs 38-55.5 hours in a digital audio device under test; an R6P lasts 27.0 hours. Shelf life varies by storage.` },
  { q: 'Are your AA batteries mercury-free?',
    a: `Yes. Our alkaline cylindrical batteries are 0% mercury and made on Japanese MITSUBISHI full-automatic lines.` },
  { q: 'Can you OEM or private label AA batteries?',
    a: `Yes. We provide custom brand label, blister and box packaging for OEM / ODM and private-label AA battery projects.` },
];

// Product schema for the AA line
const productSchema = {
  '@context': 'https://schema.org', '@type': 'Product',
  name: 'AA Batteries (LR6 / R6)',
  description: 'Alkaline LR6 (2150-2600mAh) and carbon-zinc R6P AA batteries. 1.5V, 0% mercury, 5-year shelf life. OEM / ODM custom label available.',
  brand: { '@type': 'Brand', name: brand.name },
  offers: { '@type': 'AggregateOffer', priceCurrency: 'USD', availability: 'https://schema.org/InStock' },
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faqs.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
---

<Layout title={title} description={description} schema={[productSchema, faqSchema]} breadcrumbs={crumbs}>
  <div class="container breadcrumb">{crumbs.map((c, i) => (<>{i > 0 && <span> / </span>}<a href={c.url}>{c.name}</a></>))}</div>

  <!-- Hero -->
  <section class="section reveal" style="padding:48px 0 34px;">
    <div class="container">
      <div class="product-layout">
        <div class="img-wrap">
          <div class="carousel">
            <div class="car-slides">
              <img src="/images/catalog/aa-pack.jpg" alt="AA battery blister pack R6P 4-BP" loading="eager" style="width:100%;max-height:340px;object-fit:contain;background:var(--soft);" />
              <img src="/images/philips-power-alkaline.jpg" alt="AA batteries LR6 alkaline cylindrical from TIANQIU factory" loading="lazy" style="width:100%;max-height:340px;object-fit:contain;background:var(--soft);" />
              <img src="/images/catalog/aa-2.jpg" alt="AA alkaline cells factory" loading="lazy" style="width:100%;max-height:340px;object-fit:contain;background:var(--soft);" />
            </div>
            <button class="car-arrow prev" aria-label="Previous">‹</button>
            <button class="car-arrow next" aria-label="Next">›</button>
            <div class="car-dots"><span class="on"></span><span></span><span></span></div>
          </div>
        </div>
        <div>
          <div class="eyebrow">AA Batteries (LR6 / R6)</div>
          <h1 style="font-size:clamp(42px,4.6vw,58px);">AA Batteries - Alkaline &amp; Carbon-Zinc</h1>
          <p class="lead">Factory-direct AA batteries: alkaline LR6 (2150-2600mAh) and carbon-zinc R6P, 0% mercury, 5-year shelf life, custom label &amp; blister packaging.</p>
          <div style="margin-top:24px;display:flex;gap:14px;flex-wrap:wrap;">
            <a href="/wholesale-batteries/" class="btn btn-primary">AA Batteries Wholesale</a>
            <a href="/oem-battery-manufacturing/" class="btn btn-outline">Custom AA / OEM</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Specifications -->
  <section class="section reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Specifications</div><h2>AA Battery Specifications &amp; Capacity</h2></div>
      <div style="overflow-x:auto;">
        <table>
          <thead><tr><th>Grade</th><th>Weight</th><th>Capacity</th><th>Digital Audio</th></tr></thead>
          <tbody>{lr6.perf.map(r => (<tr><td><strong>{r[0]}</strong></td><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>))}</tbody>
        </table>
      </div>
      <p style="font-size:14px;color:var(--ink-3);margin-top:12px;">{lr6.model} – {lr6.note1} · {lr6.note2}</p>
      <div class="content-block" style="margin-top:26px;">
        <div class="sec-title"><div class="ic"><i class="fa-solid fa-bolt"></i></div><h3>Carbon-Zinc AA (R6P)</h3></div>
        <p class="lead">The budget heavy-duty option: 1.5V, 900mAh (1.35Wh), 3-year shelf life, for low-drain devices.{' '}
          <span style="font-size:14px;color:var(--ink-3);">Test condition: {r6p.note1}.</span></p>
      </div>
    </div>
  </section>

  <!-- Chemistry comparison -->
  <section class="section section-alt reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Compare</div><h2>AA Battery Chemistry &amp; Capacity Comparison</h2></div>
      <div style="overflow-x:auto;">
        <table>
          <thead><tr><th>Chemistry</th><th>Voltage</th><th>Capacity</th><th>Shelf / Life</th><th>Best For</th></tr></thead>
          <tbody>{chemTable.map(r => (<tr><td><strong>{r[0]}</strong></td><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td><td>{r[4]}</td></tr>))}</tbody>
        </table>
      </div>
      <div style="margin-top:22px;display:flex;gap:12px;flex-wrap:wrap;">
        <a href="/rechargeable-battery/" class="btn btn-outline btn-sm">Rechargeable AA Batteries</a>
        <a href="/usb-rechargeable-battery/" class="btn btn-outline btn-sm">USB Rechargeable Batteries</a>
        <a href="/aaa-battery/" class="btn btn-outline btn-sm">AAA Batteries</a>
      </div>
    </div>
  </section>

  <!-- Applications -->
  <section class="section reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Applications</div><h2>Where AA Batteries Are Used</h2></div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;">{apps.map(a=>(<div style="background:#fff;border:1px solid var(--border-light);border-radius:12px;overflow:hidden;box-shadow:var(--shadow-sm);">{appImg(a)?<img src={appImg(a)} alt={a} loading="lazy" style="width:100%;height:110px;object-fit:cover;display:block;"/>:<div style="height:110px;display:flex;align-items:center;justify-content:center;background:var(--soft);"><i class="fa-solid fa-battery-three-quarters" style="font-size:26px;color:var(--primary);"></i></div>}<div style="padding:10px 8px;font-weight:700;font-size:13px;text-align:center;color:var(--ink);">{a}</div></div>))}</div>
    </div>
  </section>

  <!-- Size / model comparison -->
  <section class="section section-alt reveal">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Size Guide</div><h2>AA vs AAA vs D Battery Capacity</h2></div>
      <div style="overflow-x:auto;">
        <table>
          <thead><tr><th>Size</th><th>Voltage</th><th>Capacity</th><th>Typical Uses</th></tr></thead>
          <tbody>{sizeTable.map(r => (<tr><td><strong>{r[0]}</strong></td><td>{r[1]}</td><td>{r[2]}</td><td>{r[3]}</td></tr>))}</tbody>
        </table>
      </div>
      <div style="margin-top:22px;"><strong style="font-size:15px;">More sizes:</strong>{' '}
        <a href="/aaa-battery/" style="font-weight:600;">AAA batteries</a> ·{' '}
        <a href="/d-battery/" style="font-weight:600;">D batteries</a> ·{' '}
        <a href="/battery-pack/" style="font-weight:600;">custom battery pack</a></div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section reveal" id="faq">
    <div class="container container-narrow">
      <div class="headline-group"><div class="eyebrow">FAQ</div><h2>AA Battery FAQs</h2></div>
      {faqs.map(f => (<details><summary>{f.q}</summary><div class="a">{f.a}</div></details>))}
    </div>
  </section>

  <!-- CTA -->
  <section class="section section-alt reveal">
    <div class="container" style="text-align:center;">
      <h2>Get AA Battery Wholesale Pricing</h2>
      <p class="lead" style="margin:0 auto 24px;">Factory-direct AA batteries with OEM custom label &amp; packaging. Get a quote today.</p>
      <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;">
        <a href="/wholesale-batteries/" class="btn btn-primary">AA Batteries Wholesale</a>
        <a href="/oem-battery-manufacturing/" class="btn btn-outline">Start AA OEM Project</a>
      </div>
    </div>
  </section>

  <section class="section reveal" style="background:var(--soft);">
    <div class="container">
      <div class="headline-group"><div class="eyebrow">Available Models</div><h2>Battery Models We Manufacture</h2>
      <p class="lead">Browse the full range. Models with a specification sheet link to their detail page; others are available on request.</p></div>
      {aaLine.map(l=>(<div style="margin-top:34px;">
        <div class="eyebrow">{l.line}</div>
        <div class="grid" style="grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:12px;margin-top:14px;">
          {l.models.map(([name,slug,img])=>( slug ? <a class="card" href={'/battery-info/'+slug} style="text-align:center;padding:16px 12px;text-decoration:none;"><img src={(modelImages[(name||"").toUpperCase()]||[])[0] || img} alt={name} style="width:100%;height:96px;object-fit:contain;background:var(--soft);padding:8px;display:block;border-radius:8px;margin-bottom:6px;"><div style="font-weight:800;font-size:18px;color:var(--primary);">{name}</div><div style="font-size:13px;color:var(--ink-2);margin-top:4px;">View specs \u2192</div></a> : <div class="card" style="text-align:center;padding:16px 12px;opacity:.72;"><img src={(modelImages[(name||"").toUpperCase()]||[])[0] || img} alt={name} style="width:100%;height:96px;object-fit:contain;background:var(--soft);padding:8px;display:block;border-radius:8px;margin-bottom:6px;"><div style="font-weight:700;font-size:18px;color:var(--ink);">{name}</div><div style="font-size:13px;color:var(--muted);margin-top:4px;">On request</div></div> ))}
        </div>
      </div>))}
    </div>
  </section>

  <style>@media(min-width:1240px){body .container{max-width:960px;}}</style>
  <aside class="auto-toc"></aside>
  <style>.auto-toc{position:fixed;left:18px;top:96px;width:190px;background:#fff;border:1px solid var(--border-light);border-radius:12px;padding:12px 14px;box-shadow:0 8px 24px rgba(0,0,0,.06);z-index:30;max-height:70vh;overflow:auto;}.auto-toc .lbl{font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--ink-2);margin-bottom:8px;}.auto-toc a{display:block;padding:5px 0;font-size:12.5px;color:var(--ink-2);border-bottom:1px solid var(--border-light);line-height:1.3;}.auto-toc a.active{font-weight:800;color:var(--primary);border-left:3px solid var(--accent);padding-left:7px;}@media(max-width:1239px){.auto-toc{position:sticky;top:60px;left:0;width:100%;display:flex;flex-wrap:wrap;gap:6px;padding:8px;} .auto-toc .lbl{display:none;} .auto-toc a{border:none;padding:4px 8px;background:var(--soft);border-radius:16px;font-size:11px;}}html{scroll-behavior:smooth}</style>
  <script is:inline>(function(){var hs=[].slice.call(document.querySelectorAll("h2")).filter(function(h){return !h.closest(".auto-toc");});hs.forEach(function(h,i){if(!h.id)h.id="toc"+i;});var toc=document.querySelector(".auto-toc");if(!toc)return;var html="<div class=\"lbl\">On this page</div>";hs.forEach(function(h){html+="<a href=\"#"+h.id+"\" class=\"toc-link\">"+h.textContent.trim().slice(0,38)+"</a>";});toc.innerHTML=html;var links=toc.querySelectorAll(".toc-link");function up(){var cur=hs[0]?hs[0].id:null;hs.forEach(function(h){if(h.getBoundingClientRect().top<140)cur=h.id;});links.forEach(function(a){a.classList.toggle("active",a.getAttribute("href")==="#"+cur);});}document.addEventListener("scroll",up,{passive:true});up();})();</script>
</Layout>
