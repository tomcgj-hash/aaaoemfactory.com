---
import Layout from '../layouts/Layout.astro';
const title = 'Thank You | TIANQIU';
---
<Layout title={title} description="Thank you for contacting TIANQIU.">
  <section class="hero hero-eco"><div class="container" style="max-width:680px;text-align:center;">
    <div style="font-size:70px;color:var(--primary);margin-bottom:16px;"><i class="fa-solid fa-circle-check"></i></div>
    <h1>Thank You!</h1>
    <p class="lead" style="margin:0 auto 24px;">Your inquiry has been sent. Our team will reply shortly. In the meantime, feel free to browse our products.</p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;"><a href="/" class="btn btn-primary">Back to Home</a><a href="/button-cell-battery/" class="btn btn-outline">Browse Products</a></div>
  </div></section>
</Layout>
