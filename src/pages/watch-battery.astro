---
import Layout from '../layouts/Layout.astro';
import { watches } from '../data/watches.js';
import { batteries } from '../data/batteries.js';

const title = 'Watch Battery Replacement - Find Your Brand & Model | TIANQIU';
const description = 'Find the right watch battery and replace it yourself. Watch battery replacement by brand (Apple, Fossil) and model (377, SR626SW, 371, 364, CR2032) with real specs, DIY steps and bulk supply.';
const crumbs = [{ name:'Home', url:'/' }, { name:'Watch Batteries', url:'/watch-battery/' }];

// Model quick-reference (real Tianqiu data)
const modelSlugs = ['sr626-battery','377-battery','371-battery','364-battery','cr2032-battery'];
const modelQuick = modelSlugs.map(s => batteries.find(b => b.slug === s)).filter(Boolean);

// Brand cards (real watch data)
const brandCards = watches.map(w => ({ ...w, bat: batteries.find(b => b.url === w.batteryUrl) }));

// FAQ (FAQPage schema)
const faqs = [
  { q:'How do I know what battery my watch takes?', a:'Read the number printed on the old cell — a 377/SR626SW, 371, 364 or CR2032 are the most common watch batteries. If the mark is worn, check the watch manual or match the diameter and voltage of the old cell.' },
  { q:'Can I replace a watch battery myself?', a:'Yes, using a watch-back tool or flat screwdriver. Match the exact size and voltage, note which side faces up, and never force the case back shut.' },
  { q:'Is a 377 battery the same as SR626SW?', a:'Yes. 377 = SR626SW = AG4 = SG4 — a 6.8mm × 2.6mm, 1.55V silver-oxide cell. Either marking is a direct replacement for your watch.' },
  { q:'How long does a watch battery last?', a:'A silver-oxide watch battery typically lasts 1–3 years. Lower-drain movements last longer; lights, chronographs and alarms shorten the cycle.' },
  { q:'Which battery is best for a wristwatch — silver oxide or lithium?', a:'Silver-oxide cells (377, 371, 364) hold a steady 1.55V and are ideal for watches. Larger sport/feature watches may use a CR2032 lithium cell.' },
];
const pg = [{ '@context':'https://schema.org', '@type':'FAQPage', 'mainEntity': faqs.map(f=>({'@type':'Question','name':f.q,'acceptedAnswer':{'@type':'Answer','text':f.a}})) }];

const identifySteps = [
  { n:'01', h:'Read the old cell', p:'Open the case back and read the number on the battery — 377, SR626SW, 371, 364 or CR2032 are the most common.' },
  { n:'02', h:'Check the manual', p:'Your watch or brand spec sheet lists the recommended cell size and voltage for the movement.' },
  { n:'03', h:'Match size & voltage', p:'If the mark is worn, measure the diameter and match a cell with the same size and voltage.' },
];
const diySteps = [
  { n:'01', h:'Pry the case back', p:'Use a watch-back tool or flat-head screwdriver in the seam and lift the case back gently.' },
  { n:'02', h:'Note the polarity', p:'Check which side of the old cell faces up before you lift it out.' },
  { n:'03', h:'Remove the old cell', p:'Lift out the old battery with non-metallic tweezers — do not scratch the holder.' },
  { n:'04', h:'Fit the new cell', p:'Insert the new silver-oxide or lithium cell with the correct side up and re-seat the retainer.' },
  { n:'05', h:'Close & test', p:'Re-seal the case back and confirm the watch runs and keeps the correct time.' },
];
---

<Layout title={title} description={description} schema={pg} breadcrumbs={crumbs}>
  <div class="container breadcrumb">{crumbs.map((c,i)=>(<>{i>0 && <span> / </span>}<a href={c.url}>{c.name}</a></>))}</div>

  <section class="hero hero-watch"><div class="container" style="max-width:880px;">
    <div class="eyebrow">Watch Batteries · Factory Direct</div>
    <h1>Watch Battery Replacement — Find the Right Battery</h1>
    <p class="lead">Get the correct watch battery by brand or model and swap it in minutes. Silver-oxide and lithium watch cells, factory direct with bulk &amp; OEM supply.</p>
    <div class="trustbar">
      <div class="t"><b>{modelQuick.length}</b><span>Watch Cell Models</span></div>
      <div class="t"><b>1.55V</b><span>Silver-Oxide</span></div>
      <div class="t"><b>1–3 yr</b><span>Typical Life</span></div>
      <div class="t"><b>OEM</b><span>Custom Label</span></div>
    </div>
    <div style="margin-top:26px;display:flex;gap:14px;flex-wrap:wrap;"><a href="#find" class="btn btn-primary">Find Your Battery</a><a href="/wholesale-batteries/" class="btn btn-outline">Bulk Supply</a></div>
  </div></section>

  <!-- Brand navigation -->
  <section class="section reveal" id="find"><div class="container">
    <div class="headline-group"><div class="eyebrow">By Watch Brand</div><h2>Find Your Watch Battery by Brand</h2>
    <p class="lead">Pick your watch brand to jump to the exact battery it uses and the replacement guide.</p></div>
    <div class="grid">
      {brandCards.map(w=>(<a class="card" href={w.url} style="text-decoration:none;">
        <div style="font-size:30px;font-weight:800;color:var(--primary);margin-bottom:6px;">{w.brand}</div>
        <p style="color:var(--ink-2);font-size:15px;">Most {w.brand} watches use a <strong>{w.battery}</strong> battery.</p>
        <span class="more">{w.brand} battery replacement →</span>
      </a>))}
    </div>
    <div style="margin-top:22px;font-size:15px;color:var(--ink-3);">Looking for the cell itself? See the <a href="/button-cell-battery/">button cell battery</a> range.</div>
  </div></section>

  <!-- Model quick-reference -->
  <section class="section section-alt reveal"><div class="container">
    <div class="headline-group"><div class="eyebrow">Common Watch Batteries</div><h2>Watch Battery Size &amp; Voltage Chart</h2>
    <p class="lead">The cells below cover most men's and women's watches. Match the model or diameter to the battery you remove.</p></div>
    <div style="overflow-x:auto;"><table>
      <thead><tr><th>Model</th><th>Voltage</th><th>Diameter</th><th>Chemistry</th><th>Notes</th></tr></thead>
      <tbody>{modelQuick.map(b=>(<tr>
        <td><a href={b.url} style="font-weight:700;">{b.model}</a></td>
        <td>{b.voltage}</td><td>{b.diameter}</td><td>{b.chemistry}</td>
        <td>{b.compat.split(' = ').slice(1).slice(0,2).join(' = ')}</td>
      </tr>))}</tbody>
    </table></div>
    <div class="grid" style="margin-top:24px;">
      {modelQuick.map(b=>(<a class="card" href={b.url} style="text-decoration:none;">
        <div style="font-size:22px;font-weight:800;color:var(--primary);">{b.model}</div>
        <p style="color:var(--ink-2);font-size:14px;">{b.voltage} · {b.diameter} · {b.chemistry}</p>
        <span class="more">View {b.model} battery →</span>
      </a>))}
    </div>
  </div></section>

  <!-- How to identify -->
  <section class="section reveal"><div class="container">
    <div class="headline-group"><div class="eyebrow">How-To</div><h2>How to Identify Your Watch Battery Model</h2></div>
    <div class="steps-grid" style="grid-template-columns:repeat(3,1fr);">
      {identifySteps.map(s=>(<div class="step"><div class="sn">{s.n}</div><h4>{s.h}</h4><p>{s.p}</p></div>))}
    </div>
  </div></section>

  <!-- DIY replacement steps -->
  <section class="section section-alt reveal"><div class="container">
    <div class="headline-group"><div class="eyebrow">DIY Replacement</div><h2>How to Replace a Watch Battery</h2>
    <p class="lead">Tools: a watch-back tool or flat-head screwdriver and non-metallic tweezers.</p></div>
    <div class="steps-grid">
      {diySteps.map(s=>(<div class="step"><div class="sn">{s.n}</div><h4>{s.h}</h4><p>{s.p}</p></div>))}
    </div>
    <div class="panel-note" style="margin-top:24px;">Never use metal tools to touch the battery contacts. Match the exact size and voltage — a wrong-thickness cell can jam the case back.</div>
  </div></section>

  <!-- Battery life -->
  <section class="section reveal"><div class="container">
    <div class="headline-group"><div class="eyebrow">Battery Life</div><h2>How Long Does a Watch Battery Last?</h2>
    <p class="lead">A silver-oxide watch battery typically lasts 1–3 years. Lower-drain movements last longer; a light, chronograph or alarm shortens the cycle.</p></div>
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:22px;max-width:820px;">
      <div style="border-left:3px solid var(--primary);padding-left:14px;"><div style="font-size:32px;font-weight:800;color:var(--primary);">1–3 yr</div><div style="font-size:13px;color:var(--ink-3);">Typical watch cell life</div></div>
      <div style="border-left:3px solid var(--primary);padding-left:14px;"><div style="font-size:32px;font-weight:800;color:var(--primary);">1.55V</div><div style="font-size:13px;color:var(--ink-3);">Silver-oxide watch voltage</div></div>
      <div style="border-left:3px solid var(--primary);padding-left:14px;"><div style="font-size:32px;font-weight:800;color:var(--primary);">6.8mm</div><div style="font-size:13px;color:var(--ink-3);">Most common cell diameter (377)</div></div>
    </div>
  </div></section>

  <!-- FAQ -->
  <section class="section section-alt reveal"><div class="container container-narrow">
    <div class="headline-group"><div class="eyebrow">FAQ</div><h2>Watch Battery FAQs</h2></div>
    <div class="content-block">
      {faqs.map(f=>(<details><summary>{f.q}</summary><div class="a">{f.a}</div></details>))}
    </div>
  </div></section>

  <!-- Related / cross-links -->
  <section class="section reveal"><div class="container">
    <div class="headline-group"><div class="eyebrow">Related</div><h2>Related Watch Battery Guides</h2></div>
    <div class="grid">
      <a class="card" href="/battery-type/377-battery/" style="text-decoration:none;"><h3>377 / SR626SW</h3><p style="color:var(--ink-2);font-size:15px;">Most common small watch battery — 6.8mm × 2.6mm silver-oxide.</p><span class="more">View 377 battery →</span></a>
      <a class="card" href="/battery-type/371-battery/" style="text-decoration:none;"><h3>371 / SR920SW</h3><p style="color:var(--ink-2);font-size:15px;">Wider 9.5mm silver-oxide cell for larger watch movements.</p><span class="more">View 371 battery →</span></a>
      <a class="card" href="/battery-type/364-battery/" style="text-decoration:none;"><h3>364 / SR621SW</h3><p style="color:var(--ink-2);font-size:15px;">Thin 6.8mm × 2.1mm silver-oxide cell for slim watches.</p><span class="more">View 364 battery →</span></a>
      <a class="card" href="/key-fob-battery/" style="text-decoration:none;"><h3>Key Fob Battery</h3><p style="color:var(--ink-2);font-size:15px;">CR2032/CR2025 coin cells for car key fobs and remotes.</p><span class="more">Key fob guide →</span></a>
      <a class="card" href="/cmos-battery/" style="text-decoration:none;"><h3>CMOS Battery</h3><p style="color:var(--ink-2);font-size:15px;">CR2032 motherboard CMOS battery replacement guide.</p><span class="more">CMOS guide →</span></a>
      <a class="card" href="/button-cell-battery/" style="text-decoration:none;"><h3>All Button Cells</h3><p style="color:var(--ink-2);font-size:15px;">Browse every coin cell model from the TIANQIU factory.</p><span class="more">View all →</span></a>
    </div>
  </div></section>

  <!-- CTA -->
  <section class="section section-alt reveal"><div class="container" style="text-align:center;">
    <h2>Buy Watch Batteries in Bulk</h2>
    <p class="lead" style="margin:0 auto 24px;">Factory-direct silver-oxide &amp; lithium watch cells with OEM custom label and packaging. Get a quote today.</p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap;"><a href="/wholesale-batteries/" class="btn btn-primary">Get Wholesale Price</a><a href="/oem-battery-manufacturing/" class="btn btn-outline">Custom Watch Battery OEM</a></div>
  </div></section>
</Layout>
